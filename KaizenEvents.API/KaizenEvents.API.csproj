<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\KaizenEvents.Core\KaizenEvents.Core.csproj" />
    <ProjectReference Include="..\KaizenEvents.Infrastructure\KaizenEvents.Infrastructure.csproj" />
    <ProjectReference Include="..\KaizenEvents.Shared\KaizenEvents.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="MiniExcel" Version="1.43.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- User-uploaded content lives in uploads/ at runtime.
       Never include local-dev uploads in the publish output (production keeps its own files). -->
  <ItemGroup>
    <Content Update="uploads\**" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!-- Google service account JSON — copied next to the API DLL so the relative
       path "secrets/..." in appsettings resolves at runtime. SDK already includes
       .json files implicitly; use Update to set the copy behaviour. -->
  <ItemGroup>
    <Content Update="secrets\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
