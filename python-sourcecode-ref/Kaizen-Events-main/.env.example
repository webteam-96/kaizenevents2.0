# Kaizen Events - Environment Variables Template
# Copy this file to .env and fill in the values

# ============================================
# Database Configuration
# ============================================
MONGO_USERNAME=admin
MONGO_PASSWORD=your-secure-mongodb-password
# For Docker: mongodb://admin:password@mongodb:27017/kaizen_events?authSource=admin
# For Local: mongodb://localhost:27017
MONGO_URL=mongodb://localhost:27017
DB_NAME=kaizen_events

# ============================================
# Security Configuration
# ============================================
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=your-64-character-random-string-here

# ============================================
# Application URLs
# ============================================
FRONTEND_URL=https://your-domain.com
REACT_APP_BACKEND_URL=https://your-domain.com/api
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ============================================
# Payment Gateway - Razorpay
# ============================================
RAZORPAY_KEY_ID=REDACTED_RAZORPAY_KEY
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# Payment Gateway - Instamojo
# ============================================
INSTAMOJO_CLIENT_ID=your-client-id
INSTAMOJO_CLIENT_SECRET=your-client-secret

# ============================================
# Email Service - Brevo (Sendinblue)
# ============================================
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# WhatsApp Service - Interakt
# ============================================
INTERACT_API_KEY=your-interakt-api-key

# ============================================
# Google Services (Optional)
# ============================================
# Base64 encoded service account JSON
GOOGLE_SHEETS_CREDENTIALS=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Ii4uLn0=

# ============================================
# Optional Configuration
# ============================================
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Maximum file upload size in bytes (default: 50MB)
MAX_UPLOAD_SIZE=52428800
