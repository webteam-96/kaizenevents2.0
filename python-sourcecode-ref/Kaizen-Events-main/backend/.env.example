# ============================================
# KAIZEN EVENTS - BACKEND ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================

# ==================== DATABASE ====================
# MongoDB connection string
# Local: mongodb://127.0.0.1:27017
# Atlas: mongodb+srv://user:password@cluster.mongodb.net/
MONGO_URL="mongodb://127.0.0.1:27017"

# Database name
DB_NAME="kaizen_events"

# ==================== SECURITY KEYS ====================
# IMPORTANT: Generate your own keys using the command below:
# python3 -c "import secrets; print(secrets.token_urlsafe(64))"

# JWT signing key (64+ characters)
JWT_SECRET_KEY="GENERATE_YOUR_OWN_64_CHAR_KEY_HERE"

# JWT refresh token key (64+ characters)
JWT_REFRESH_SECRET="GENERATE_YOUR_OWN_64_CHAR_KEY_HERE"

# AES-256 encryption key for sensitive data (32+ characters)
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY="GENERATE_YOUR_OWN_32_CHAR_KEY_HERE"

# Request signing key for API integrity (32+ characters)
REQUEST_SIGNING_KEY="GENERATE_YOUR_OWN_32_CHAR_KEY_HERE"

# ==================== CORS & URLS ====================
# Comma-separated list of allowed frontend origins
# NO wildcards (*) in production!
CORS_ORIGINS="http://localhost:3000,https://yourdomain.com"

# Frontend URL (for email links, redirects)
FRONTEND_URL="http://localhost:3000"

# ==================== PAYMENT GATEWAYS ====================
# Razorpay (https://dashboard.razorpay.com)
RAZORPAY_KEY_ID="REDACTED_RAZORPAY_KEY"
RAZORPAY_KEY_SECRET="your_razorpay_secret"

# Instamojo (https://www.instamojo.com/developers/)
INSTAMOJO_CLIENT_ID="your_instamojo_client_id"
INSTAMOJO_CLIENT_SECRET="your_instamojo_client_secret"
INSTAMOJO_MODE="test"  # "test" or "production"

# ==================== EMAIL (BREVO/SENDINBLUE) ====================
# Get API key from https://app.brevo.com/settings/keys/api
BREVO_API_KEY="xkeysib-xxxxxxxxxxxx"

# ==================== WHATSAPP (INTERAKT) ====================
# Get key from https://app.interakt.ai/
INTERAKT_SECRET_KEY="your_interakt_secret_key"

# ==================== GOOGLE INTEGRATIONS ====================
# Google Sheets & Drive API (optional)
# Create credentials at https://console.cloud.google.com/
GOOGLE_SERVICE_ACCOUNT_JSON=""

# ==================== OPTIONAL SETTINGS ====================
# Disable API documentation in production (set to "true")
DISABLE_DOCS=""

# Debug mode (leave empty for production)
DEBUG=""
