<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>

        <!-- Raise URL and query-string limits so ModSecurity / IIS request
             filtering does not reject long Cashfree session IDs.             -->
        <security>
            <requestFiltering>
                <requestLimits
                    maxUrl="65536"
                    maxQueryString="65536"
                    maxAllowedContentLength="1048576" />
            </requestFiltering>
        </security>

        <!-- Tell ModSecurity IIS module to skip inspection for this directory.
             The SecRuleEngine directive requires the ModSecurity IIS module to
             honour per-directory overrides (enabled in most Plesk setups).    -->
        <ModSecurity enabled="false" configFile="c:\inetpub\wwwroot\modsecurity.conf" />

    </system.webServer>
</configuration>
